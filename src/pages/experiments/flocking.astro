---
const canonical = new URL(Astro.url.pathname, Astro.site);
const sliders = [
  { id: 'count', label: 'Count', min: 50, max: 800, step: 50, value: 300 },
  { id: 'speed', label: 'Speed', min: 0.5, max: 2, step: 0.1, value: 1 },
  { id: 'separation', label: 'Separation', min: 0, max: 3, step: 0.1, value: 1.5 },
  { id: 'alignment', label: 'Alignment', min: 0, max: 3, step: 0.1, value: 1 },
  { id: 'cohesion', label: 'Cohesion', min: 0, max: 3, step: 0.1, value: 1 },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <title>Flocking — Gerald Spencer</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/g3.ico" />
  </head>
  <body class="flocking-page">
    <a class="skip-link" href="#main">Skip to flock</a>
    <main id="main" tabindex="-1">
      <canvas id="flock" tabindex="0" aria-label="Flocking birds. Move to repel; hold to attract. Keyboard: arrow keys move the pointer, Enter toggles attraction."></canvas>
      <header><a href="/" aria-label="Home">G3<span>.</span></a><div class="experiment-links"><span>Flocking</span><a href="https://github.com/Geethree/g3-site/tree/master/experiments/flocking" aria-label="Flocking source on GitHub">GitHub</a></div></header>
      <details class="controls" open>
        <summary>Controls</summary>
        <div class="sliders">
          {sliders.map(({ id, label, ...attributes }) => <div class="slider">
            <label for={id}>{label}</label><output id={`${id}-value`} for={id}>{attributes.value}</output>
            <input id={id} type="range" {...attributes} />
          </div>)}
          <div class="buttons"><button id="pause" type="button" aria-pressed="false">Pause</button><button id="reset" type="button">Reset</button></div>
        </div>
      </details>
      <p class="hint">Move to repel · Hold to attract</p>
      <p id="status" role="status">Loading…</p>
      <noscript><p class="error">Enable JavaScript to run this experiment.</p></noscript>
    </main>
    <script is:inline type="module">
      if (matchMedia('(max-width: 600px)').matches) document.querySelector('.controls').open = false;
      import('/experiments/flocking/wasm/flocking.js').then(({ default: init }) => init()).catch(error => {
        document.getElementById('status').textContent = `Unable to start: ${error.message || error}`;
      });
    </script>
  </body>
</html>
<style>
  :global(body.flocking-page) { margin: 0; background: #030509; color: #d8e2ee; font: 13px system-ui, sans-serif; }
  main { width: 100%; margin: 0; height: 100svh; min-height: 320px; position: relative; overflow: hidden; }
  canvas { display: block; width: 100%; height: 100%; touch-action: none; }
  canvas:focus-visible { outline: 2px solid #79e3dd; outline-offset: -3px; }
  header { position: absolute; left: 32px; right: 32px; top: 28px; display: flex; justify-content: space-between; align-items: center; pointer-events: none; }
  header a { color: #eef3fb; text-decoration: none; font-size: 24px; font-weight: 650; letter-spacing: -1px; pointer-events: auto; }
  header a span { color: #79e3dd; }
  header .experiment-links { display: flex; align-items: center; gap: 20px; color: #91a0b5; }
  header .experiment-links a { color: inherit; font-size: 13px; font-weight: 400; letter-spacing: normal; }
  header .experiment-links a:hover { color: #79e3dd; }
  .controls { position: absolute; right: 32px; top: 84px; width: 240px; background: #0c1222ee; border: 1px solid #263044; border-radius: 8px; }
  summary { padding: 14px 16px; cursor: pointer; }
  .sliders { padding: 0 16px 16px; }
  .slider { display: grid; grid-template-columns: 1fr auto; gap: 8px; margin-bottom: 18px; }
  output { color: #92c9cf; font-variant-numeric: tabular-nums; }
  input { grid-column: 1 / -1; width: 100%; margin: 0; accent-color: #79e3dd; cursor: pointer; }
  .buttons { display: flex; gap: 8px; }
  button { flex: 1; padding: 10px 15px; background: #141e30; color: #d8e2ee; border: 1px solid #34445b; border-radius: 6px; font: inherit; cursor: pointer; }
  button:hover { background: #25354d; }
  button:focus-visible, summary:focus-visible, input:focus-visible, a:focus-visible { outline: 2px solid #79e3dd; outline-offset: 4px; }
  .hint { position: absolute; left: 32px; bottom: 30px; color: #8494aa; margin: 0; pointer-events: none; }
  #status, .error { position: absolute; top: 48%; width: 100%; text-align: center; padding: 0 24px; }
  #status:empty { display: none; }
  @media (max-width: 600px) {
    header { left: 20px; right: 20px; top: 20px; }
    .controls { top: auto; right: 20px; bottom: 20px; width: min(280px, calc(100% - 40px)); max-height: calc(100% - 90px); overflow-y: auto; }
    .hint { left: 20px; bottom: 78px; font-size: 12px; }
    main:has(.controls[open]) .hint { display: none; }
  }
</style>
