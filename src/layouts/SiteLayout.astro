---
import { identity } from '../site';
import WebAnalytics from '../components/WebAnalytics.astro';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import regularFont from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import mediumFont from '@fontsource/inter/files/inter-latin-500-normal.woff2?url';
import '../styles/site.css';

interface Props {
  title?: string;
  section?: 'about' | 'works';
  cover?: string;
  noindex?: boolean;
}
const { title, section, cover, noindex = false } = Astro.props;
const pageTitle = title ? `${title} — ${identity.name}` : identity.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={identity.description} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {cover && <meta property="og:image" content={new URL(cover, Astro.site)} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/g3.ico" />
    <link rel="preload" href={regularFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={mediumFont} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class:list={['site-header', { 'home-header': isHome }]}>
      {!isHome && <a class="wordmark" href="/" aria-label="Gerald Spencer, home">{identity.name}<span class="brand-dot" aria-hidden="true">.</span></a>}
      <nav aria-label="Main navigation">
        <a href="/about/" aria-current={section === 'about' ? 'page' : undefined}>About</a>
        <a href="/works/" aria-current={section === 'works' ? 'page' : undefined}>Works</a>
        <a href="/gerald-spencer.pdf">Resume</a>
        <details class="experiments">
          <summary>Experiments</summary>
          <div class="experiments-menu"><a href="/play/">Field</a><a href="/experiments/flocking/">Flocking</a></div>
        </details>
        <button class="theme-toggle" type="button" aria-label="Switch to dark mode" title="Switch to dark mode" hidden>
          <svg class="theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.9 13A9 9 0 0 1 11 3.1 9 9 0 1 0 20.9 13Z" /></svg>
          <svg class="theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg>
        </button>
      </nav>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <span>{identity.name}</span>
      <div><a href={identity.github}>GitHub</a><a href={identity.linkedin}>LinkedIn</a><a href={`mailto:${identity.email}`}>Email</a></div>
    </footer>
    <script>import '../lib/experiments-menu.js';</script>
    <script>import '../lib/theme-toggle';</script>
    <WebAnalytics />
  </body>
</html>
