load("@flocking_crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_shared_library.bzl", "rust_shared_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")
load("@rules_rust_wasm_bindgen//:defs.bzl", "rust_wasm_bindgen")

exports_files(["Cargo.toml", "Cargo.lock"])

rust_shared_library(
    name = "flocking",
    srcs = glob(["*.rs"], exclude = ["tests.rs"]),
    compile_data = ["bird.vert", "bird.frag"],
    edition = "2024",
    deps = all_crate_deps(normal = True),
    platform = "@rules_rs//rs/platforms:wasm32-unknown-unknown",
    rustc_flags = ["-Copt-level=3"],
)

rust_wasm_bindgen(
    name = "web",
    wasm_file = ":flocking",
    target = "web",
    out_name = "flocking",
    bindgen_flags = ["--no-typescript"],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "simulation_test",
    srcs = ["simulation.rs", "math.rs", "grid.rs", "tests.rs"],
    crate_root = "simulation.rs",
    edition = "2024",
    visibility = ["//visibility:public"],
)
